<idea-plugin>
    <id>org.jormungandr.ide</id>
    <name>Jörmungandr</name>
    <vendor email="abmitra1999@gmail.com" url="https://github.com/indoctrinatedrecluse/J-rmungandr">indoctrinatedrecluse</vendor>

    <description><![CDATA[
        <h1>🐍 Jörmungandr 🌊</h1>
        <p>A high-performance, modular Data Science &amp; Analytics IDE built on top of the open-source IntelliJ Platform and Python Community plugins.</p>
        <ul>
            <li>🪐 <b>Jupyter &amp; Interactive Notebooks:</b> First-class .ipynb editor and ZeroMQ kernel protocol client.</li>
            <li>🗄️ <b>Database Analytics Studio:</b> PostgreSQL, DuckDB, SQLite, MySQL, and MongoDB consoles.</li>
            <li>🏹 <b>Apache Arrow Dataframe Explorer:</b> Virtualized tabular display for 1M+ rows.</li>
            <li>🧩 <b>Governed Modular Extension Manager:</b> Deterministic lifecycles, memory quotas, and clean disposal.</li>
        </ul>
    ]]></description>

    <!-- IntelliJ Platform Module Dependencies -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <extensionPoints>
        <extensionPoint name="extension" interface="org.jormungandr.core.extension.JormungandrExtension" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-level services -->
        <applicationService
            serviceInterface="org.jormungandr.core.extension.ExtensionManager"
            serviceImplementation="org.jormungandr.core.extension.impl.ExtensionManagerImpl"/>
        <applicationService
            serviceInterface="org.jormungandr.core.theme.ThemeManager"
            serviceImplementation="org.jormungandr.shell.theme.ThemeExtension"/>

        <!-- Universal Theme Providers -->
        <themeProvider id="org.jormungandr.theme.solarized.light" path="/themes/SolarizedLight.theme.json"/>
        <themeProvider id="org.jormungandr.theme.bubblegum.barbie" path="/themes/BubblegumBarbie.theme.json"/>

        <!-- R Language & Statistical REPL Subsystem -->
        <applicationService serviceImplementation="org.jormungandr.shell.r.RDiscoveryService"/>
        <toolWindow id="R Console"
                    anchor="bottom"
                    canCloseContent="true"
                    icon="/icons/jormungandr_16.png"
                    factoryClass="org.jormungandr.shell.r.RReplToolWindowFactory"/>

        <!-- Hardware Telemetry & GPU Monitor Subsystem -->
        <applicationService serviceImplementation="org.jormungandr.shell.telemetry.HardwareTelemetryService"/>
        <statusBarWidgetFactory id="org.jormungandr.shell.telemetry.GpuStatusBarWidget"
                                implementation="org.jormungandr.shell.telemetry.GpuStatusBarWidgetFactory"/>

        <!-- Local AI, LLM & Prompt Engineering Studio -->
        <applicationService serviceImplementation="org.jormungandr.shell.copilot.local.OllamaService"/>
        <toolWindow id="Prompt Studio"
                    anchor="right"
                    canCloseContent="true"
                    icon="/icons/jormungandr_16.png"
                    factoryClass="org.jormungandr.shell.copilot.local.PromptStudioToolWindowFactory"/>

        <!-- Commercial Licensing & Extension Gating Subsystem -->
        <applicationService serviceImplementation="org.jormungandr.core.license.LicenseService"/>
        <statusBarWidgetFactory id="org.jormungandr.shell.license.LicenseStatusBarWidget"
                                implementation="org.jormungandr.shell.license.LicenseStatusBarWidgetFactory"/>

        <!-- Animated Splash Screen & Branding Lifecycle -->
        <applicationInitializedListener implementation="org.jormungandr.shell.splash.JormungandrAppInitializer"/>
        <postStartupActivity implementation="org.jormungandr.shell.splash.JormungandrStartupActivity"/>
    </extensions>

    <actions>
        <!-- Project Creation Action -->
        <action id="Jormungandr.NewDataScienceProject"
                class="org.jormungandr.shell.project.NewDataScienceProjectAction"
                text="New Data Science Workspace..."
                description="Create a new structured data science, machine learning, or OLAP workspace from curated templates"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="NewGroup" anchor="first"/>
            <add-to-group group-id="FileMenu" anchor="first"/>
        </action>

        <group id="Jormungandr.PerspectiveGroup" text="Perspective" popup="true" icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ViewMenu" anchor="first"/>
            <action id="Jormungandr.Perspective.Analysis"
                    class="org.jormungandr.shell.perspective.SwitchToAnalysisPerspectiveAction"
                    text="Analysis Mode (Notebook &amp; Data)"
                    description="Switch to data exploration perspective"/>
            <action id="Jormungandr.Perspective.Database"
                    class="org.jormungandr.shell.perspective.SwitchToDatabasePerspectiveAction"
                    text="Database Mode (SQL &amp; Storage)"
                    description="Switch to database and query perspective"/>
            <action id="Jormungandr.Perspective.Code"
                    class="org.jormungandr.shell.perspective.SwitchToCodePerspectiveAction"
                    text="Code Mode (Standard IDE)"
                    description="Switch to code editor perspective"/>
        </group>

        <!-- View Menu Actions -->
        <action id="Jormungandr.View.Extensions"
                class="org.jormungandr.shell.ui.extensions.ExtensionsAction"
                text="Data Science Subsystems &amp; Resource Monitor..."
                description="Monitor active data science engines, worker thread pools, memory quotas, and cache trimming"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ViewMenu" anchor="after" relative-to-action="Jormungandr.PerspectiveGroup"/>
        </action>

        <action id="Jormungandr.View.Themes"
                class="org.jormungandr.shell.ui.theme.ThemesAction"
                text="Themes..."
                description="View available visual themes and switch active theme in real time"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ViewMenu" anchor="after" relative-to-action="Jormungandr.View.Extensions"/>
        </action>

        <!-- Tools Menu Action -->
        <action id="Jormungandr.Tools.RConsole"
                class="org.jormungandr.shell.r.NewRReplConsoleAction"
                text="R Interactive REPL Console..."
                description="Open the interactive R statistical and graphical REPL console"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>

        <action id="Jormungandr.Tools.GpuMonitor"
                class="org.jormungandr.shell.telemetry.ShowGpuMonitorAction"
                text="GPU &amp; Hardware Compute Monitor..."
                description="Inspect real-time GPU compute, VRAM allocation, and thermal status"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="Jormungandr.Tools.RConsole"/>
        </action>

        <action id="Jormungandr.Tools.PromptStudio"
                class="org.jormungandr.shell.copilot.local.OpenPromptStudioAction"
                text="Local AI &amp; Prompt Studio..."
                description="Open Prompt Studio for local Ollama LLM inference and prompt engineering"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="Jormungandr.Tools.GpuMonitor"/>
        </action>

        <group id="Jormungandr.EditorAiActions" text="Jörmungandr AI Actions" popup="true" icon="/icons/jormungandr_16.png">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="Jormungandr.Editor.GenerateDocstring"
                    class="org.jormungandr.shell.copilot.local.GenerateDocstringAction"
                    text="Generate Data Pipeline Docstring"
                    description="Auto-generate Google-style docstrings with parameter and return types"/>
            <action id="Jormungandr.Editor.GeneratePytest"
                    class="org.jormungandr.shell.copilot.local.GeneratePytestAction"
                    text="Generate PyTest Suite &amp; DataFrame Fixtures"
                    description="Auto-generate pytest unit tests with mock DataFrame fixtures"/>
        </group>

        <!-- Help Menu Action -->
        <action id="Jormungandr.Tools.ManageLicense"
                class="org.jormungandr.shell.license.ManageLicenseAction"
                text="Manage Jörmungandr License..."
                description="View, activate, or manage Jörmungandr commercial license"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="Jormungandr.Tools.PromptStudio"/>
            <add-to-group group-id="HelpMenu" anchor="before" relative-to-action="Jormungandr.Help.About"/>
        </action>

        <action id="Jormungandr.Help.About"
                class="org.jormungandr.shell.ui.about.AboutAction"
                text="About Jörmungandr"
                description="About Jörmungandr, author attribution, and license"
                icon="/icons/jormungandr_16.png">
            <add-to-group group-id="HelpMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
