<idea-plugin>
    <id>org.jormungandr.dataframe</id>
    <name>DataFrame Viewer &amp; Charting Studio</name>
    <version>0.1.0</version>
    <vendor email="abmitra1999@gmail.com" url="https://github.com/indoctrinatedrecluse/Jormungandr">indoctrinatedrecluse</vendor>

    <description><![CDATA[
        <h1>📊 DataFrame Viewer &amp; 2D Charting Studio</h1>
        <p>Flagship high-performance tabular dataset viewer and 2D vector charting engine for Jörmungandr.</p>
        <ul>
            <li><b>Multi-Tab Studio:</b> Grid View, interactive 2D Vector Chart View, and Column Profiler</li>
            <li><b>2D Vector Charts:</b> Bar, Line, Scatter, and Histogram charts with live hover inspection and PNG export</li>
            <li><b>Statistical Profiling:</b> Quartiles (Q25, Q50, Q75), IQR, variance, skewness, distribution histograms</li>
            <li><b>Dynamic Filter Builder:</b> Compound AND/OR conditions across 13 comparison operators</li>
            <li><b>Data Transformations:</b> SQL-style groupBy aggregations and Pandas-like describe()</li>
            <li><b>Code Generator:</b> Instant export to Pandas, Polars, and SQL DDL + Inserts scripts</li>
            <li><b>Heatmap Rendering:</b> Percentile gradient background highlighting for numeric cells</li>
        </ul>
    ]]></description>

    <category>Data Science</category>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jormungandr.ide</depends>

    <extensions defaultExtensionNs="org.jormungandr.ide">
        <extension implementation="org.jormungandr.dataframe.DataFrameViewerExtension"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="org.jormungandr.dataframe.service.DataFrameService"/>

        <fileType name="CSV Dataset"
                  language="TEXT"
                  implementationClass="org.jormungandr.dataframe.filetype.CsvFileType"
                  fieldName="INSTANCE"
                  extensions="csv;tsv;tab"/>

        <fileType name="Parquet Dataset"
                  implementationClass="org.jormungandr.dataframe.filetype.ParquetFileType"
                  fieldName="INSTANCE"
                  extensions="parquet"/>

        <fileType name="Model Checkpoint"
                  implementationClass="org.jormungandr.dataframe.filetype.ModelCheckpointFileType"
                  fieldName="INSTANCE"
                  extensions="safetensors;onnx;pt;pth;h5;hdf5"/>

        <fileEditorProvider implementation="org.jormungandr.dataframe.ui.editor.DataFrameEditorProvider"/>
        <fileEditorProvider implementation="org.jormungandr.dataframe.ui.editor.ModelCheckpointEditorProvider"/>

        <toolWindow id="DataFrame Viewer"
                    anchor="bottom"
                    canCloseContent="true"
                    icon="/icons/dataframe_16.png"
                    factoryClass="org.jormungandr.dataframe.ui.toolwindow.DataFrameToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="Jormungandr.Lakehouse.Inspector"
                class="org.jormungandr.dataframe.lakehouse.LakehouseInspectorAction"
                text="Inspect Lakehouse &amp; Parquet Deep Chunks..."
                description="Inspect Parquet binary chunk encodings, compression ratios, and Delta/Iceberg time-travel"
                icon="/icons/dataframe_16.png">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
